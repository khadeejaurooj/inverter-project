# Copy this file to ".env" and adjust. ".env" is git-ignored and never committed.
# Real environment variables take priority over this file.

# Port the demo backend listens on. The Flutter app's default backend port is 24301.
PORT=24301

# Network interface to bind to.
#   0.0.0.0    reachable from other devices on your network (phones, emulators)
#   127.0.0.1  this computer only (safer when you do not need other devices)
HOST=0.0.0.0

# Password given to every demo user that has no "password" field in the data file.
# This default is a public demo value: change it if the server is reachable by others.
DEMO_PASSWORD=Demo@1234

# Optional: use your own demo data instead of demo-data.example.json.
# Copy demo-data.example.json to demo-data.json (git-ignored) and edit it, or point
# this at any other file.
# DEMO_DATA_FILE=./demo-data.json
